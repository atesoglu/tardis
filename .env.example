# --- Azure AD (Entra ID) application for dashboard ---
VITE_AZURE_AD_CLIENT_ID=replace-with-your-client-id
VITE_AZURE_AD_TENANT_ID=replace-with-your-tenant-id
VITE_REDIRECT_URI=http://localhost:3000
VITE_API_BASE=http://localhost:5000

# --- Azure AD application for gateway (backend) ---
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=replace-with-your-tenant-id
AzureAd__Audience=api://tardis

# --- Compose project name ---
COMPOSE_PROJECT_NAME=tardis