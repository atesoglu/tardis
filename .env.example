# Tardis Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Azure Configuration
# =============================================================================
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# =============================================================================
# Azure DevOps Configuration
# =============================================================================
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_URL=https://dev.azure.com/your-org-name

# =============================================================================
# Azure Resources (Dev Environment)
# =============================================================================
AZURE_RESOURCE_GROUP=tardis-rg-dev
AZURE_LOCATION=westeurope
ACR_LOGIN_SERVER=tardisacrdev.azurecr.io
APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# =============================================================================
# Database Configuration
# =============================================================================
SQL_SERVER=tardis-sql-dev.database.windows.net
SQL_DATABASE=tardis-db-dev
SQL_ADMIN_USER=sqladmin
# SQL_PASSWORD=stored-in-key-vault

COSMOS_ACCOUNT=tardis-cosmos-dev
COSMOS_DATABASE=tardis-db
# COSMOS_KEY=stored-in-key-vault

# =============================================================================
# Storage Configuration
# =============================================================================
STORAGE_ACCOUNT=sttardisdev
# STORAGE_KEY=stored-in-key-vault

# =============================================================================
# AI/ML Configuration
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01

# =============================================================================
# GitHub Configuration
# =============================================================================
GITHUB_ORG=your-github-org
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# Notification Configuration
# =============================================================================
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Frontend Configuration (Dashboard)
# =============================================================================
VITE_AZURE_AD_CLIENT_ID=your-client-id
VITE_AZURE_AD_TENANT_ID=your-tenant-id
VITE_REDIRECT_URI=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_PR_REVIEW=true
FEATURE_AUTO_MERGE=true
FEATURE_TASK_AUTO_ASSIGN=true
FEATURE_HYBRID_SIMULATION=true
FEATURE_POWERBI_EMBED=false

# =============================================================================
# Logging & Monitoring
# =============================================================================
LOG_LEVEL=Information
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development