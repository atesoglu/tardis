<Project>
  <!-- GitVersion integration for versioning -->
  <PropertyGroup>
    <GitVersionToolVersion>5.12.0</GitVersionToolVersion>
  </PropertyGroup>

  <!-- Enable GitVersion for projects that opt-in -->
  <PropertyGroup Condition="'$(UseGitVersion)' == 'true'">
    <Version>$([MSBuild]::GetTargetPath($(GitVersion_FullSemVer)))</Version>
    <AssemblyVersion>$([MSBuild]::GetTargetPath($(GitVersion_AssemblySemVer)))</AssemblyVersion>
    <FileVersion>$([MSBuild]::GetTargetPath($(GitVersion_FileSemVer)))</FileVersion>
    <InformationalVersion>$(GitVersion_FullSemVer)+$(GitVersion_Sha)</InformationalVersion>
  </PropertyGroup>

  <!-- Docker support -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>$(MSBuildThisFileDirectory)</DockerfileContext>
  </PropertyGroup>

  <!-- Publish settings for Container Apps -->
  <PropertyGroup Condition="'$(PublishProfile)' == 'ContainerApp'">
    <PublishUrl>$(ContainerAppName).azurecontainerapps.io</PublishUrl>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- SonarCloud analysis -->
  <PropertyGroup Condition="'$(BuildSource)' == 'SonarCloud'">
    <SonarQubeExcludeTestFiles>true</SonarQubeExcludeTestFiles>
  </PropertyGroup>
</Project>