<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Host/worker composition -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- .NET 10 / Microsoft extensions -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <!-- Azure SDK -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Monitor.Query" Version="1.7.1" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- Microsoft Graph / Azure DevOps -->
    <PackageVersion Include="Microsoft.Graph" Version="6.9.0" />
    <!-- (Removed Azure Functions worker — K8s-native monolith refactor) -->    <!-- Azure SignalR -->
    <PackageVersion Include="Microsoft.Azure.SignalR" Version="1.33.1" />
    <!-- Azure AD -->
    <!-- Polly -->
    <PackageVersion Include="Polly" Version="8.8.1" />
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
    <!-- Quartz -->
    <PackageVersion Include="Quartz" Version="4.6.2" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.6.2" />
    <!-- Power BI -->
    <PackageVersion Include="Microsoft.PowerBI.Api" Version="5.1.0" />
    <!-- Build & Source Link (used in Directory.Build.props) -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <!-- Test packages -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>