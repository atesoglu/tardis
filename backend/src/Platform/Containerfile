# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Tardis.slnx ./Tardis.slnx
COPY Directory.Build.props Directory.Build.targets Directory.Packages.props global.json ./
COPY src/Platform/Platform.csproj ./src/Platform/
COPY src/Persistence/Persistence.csproj ./src/Persistence/
RUN dotnet restore src/Platform/Platform.csproj
COPY . .
WORKDIR /src/src/Platform
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5000
EXPOSE 5000
ENTRYPOINT ["dotnet", "Platform.dll"]